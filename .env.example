# Copy to .env for production (docker-compose env_file). Never commit .env.

# --- Database ---
# Production (compose network): the host is the db container name.
DATABASE_URL="postgresql://auction:CHANGE_ME@auction-db:5432/auction"

# Used by docker-compose to initialise the Postgres container — keep in sync
# with the credentials embedded in DATABASE_URL above.
POSTGRES_USER=auction
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=auction

# --- Auth.js / Google OAuth (admin dashboard) ---
# Create an OAuth 2.0 Client (type "Web application") in Google Cloud Console.
# Add this app's callback URL to that client's authorised redirect URIs:
#   https://auction.example.org/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a fresh secret: openssl rand -base64 32
AUTH_SECRET=
# Exact public origin, no trailing slash.
AUTH_URL=https://auction.example.org

# --- Admin authorization ---
# Comma-separated Google account emails allowed into /admin.
ALLOWED_ADMIN_EMAILS=admin@example.org
# Optional: allow any account on this Workspace domain. Leave unset to require
# exact-email allowlisting only.
# ALLOWED_GOOGLE_DOMAIN=example.org

# --- Bidder sessions ---
# HMAC secret that signs the httpOnly bidder cookie. Generate:
#   openssl rand -base64 32
BIDDER_SESSION_SECRET=

# --- App ---
NODE_ENV=production
LOG_LEVEL=info
